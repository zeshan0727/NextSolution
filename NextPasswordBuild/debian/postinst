#!/bin/sh
set -e

APP="/Applications/NextPassword.app"
if [ -d "$APP" ]; then
  if command -v ldid >/dev/null 2>&1; then
    [ -f "$APP/PlugIns/PasswordKeyboard.appex/PasswordKeyboard" ] && ldid -S "$APP/PlugIns/PasswordKeyboard.appex/PasswordKeyboard" || true
    [ -f "$APP/NextPassword" ] && ldid -S "$APP/NextPassword" || true
  fi
fi

if command -v uicache >/dev/null 2>&1; then
  uicache -p "$APP" >/dev/null 2>&1 || uicache -a >/dev/null 2>&1 || true
fi

exit 0
