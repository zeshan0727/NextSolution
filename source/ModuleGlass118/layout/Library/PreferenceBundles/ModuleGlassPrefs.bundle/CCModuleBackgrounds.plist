<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>Module Glass</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>APPEARANCE</string>
			<key>footerText</key>
			<string>Premium Control Center styling by Next Jailbreak. Existing module behavior and gestures remain native.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Enable Module Backgrounds</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>CCModuleBackgroundsEnabled</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Show the selected image behind each matching Control Center module.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Remove Stock Module Blur</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>CCModuleRemoveBlur</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Remove Apple's stock blur only from modules that use a custom image.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Image Opacity</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>CCModuleBackgroundOpacity</string>
			<key>default</key>
			<real>1.0</real>
			<key>min</key>
			<real>0.25</real>
			<key>max</key>
			<real>1.0</real>
			<key>showValue</key>
			<true/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Adjust the visibility of all selected module background images.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Glow Icons &amp; Labels</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>CCModuleControlGlowEnabled</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Add safe illumination to module icons and text without changing their layout.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Glow Brightness</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>CCModuleControlGlowIntensity</string>
			<key>default</key>
			<real>0.8</real>
			<key>min</key>
			<real>0.1</real>
			<key>max</key>
			<real>1.0</real>
			<key>showValue</key>
			<true/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Adjust how prominently module icons and labels glow.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Glow Spread</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>CCModuleControlGlowWidth</string>
			<key>default</key>
			<real>1.5</real>
			<key>min</key>
			<real>0.5</real>
			<key>max</key>
			<real>4.0</real>
			<key>showValue</key>
			<true/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Adjust the soft glow radius around module icons and labels.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>MODULE IMAGES</string>
			<key>footerText</key>
			<string>Open a category, then tap any module to choose or remove its image.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>Core Modules</string>
			<key>detail</key>
			<string>AuraCategoryListController</string>
			<key>isController</key>
			<true/>
			<key>plist</key>
			<string>ModuleGlassCoreModules</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>Quick Controls</string>
			<key>detail</key>
			<string>AuraCategoryListController</string>
			<key>isController</key>
			<true/>
			<key>plist</key>
			<string>ModuleGlassQuickControls</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>Display &amp; System</string>
			<key>detail</key>
			<string>AuraCategoryListController</string>
			<key>isController</key>
			<true/>
			<key>plist</key>
			<string>ModuleGlassDisplaySystem</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>Accessories &amp; Apps</string>
			<key>detail</key>
			<string>AuraCategoryListController</string>
			<key>isController</key>
			<true/>
			<key>plist</key>
			<string>ModuleGlassAccessoriesApps</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>Other &amp; Reset</string>
			<key>detail</key>
			<string>AuraCategoryListController</string>
			<key>isController</key>
			<true/>
			<key>plist</key>
			<string>ModuleGlassOtherReset</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>APPLY CHANGES</string>
			<key>footerText</key>
			<string>Apply your saved settings immediately, or respring if another tweak has cached Control Center.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Apply Module Glass</string>
			<key>action</key>
			<string>applyCCModuleBackgrounds:</string>
			<key>description</key>
			<string>Reload Module Glass settings without a full respring.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Respring</string>
			<key>action</key>
			<string>respringDevice:</string>
			<key>description</key>
			<string>Restart SpringBoard and reload every module.</string>
		</dict>
	</array>
</dict>
</plist>
