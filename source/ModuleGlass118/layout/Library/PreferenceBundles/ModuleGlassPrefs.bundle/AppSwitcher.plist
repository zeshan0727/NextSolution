<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>App Switcher</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>App Switcher</string>
			<key>footerText</key>
			<string>Card, label, spacing, and background controls for the App Switcher.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>label</key>
			<string>Switcher Card Size</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabSwitcherCardScale</string>
			<key>default</key>
			<real>1.0</real>
			<key>validTitles</key>
			<array>
				<string>Compact</string>
				<string>Normal</string>
				<string>Large</string>
			</array>
			<key>validValues</key>
			<array>
				<real>0.84</real>
				<real>1.0</real>
				<real>1.08</real>
			</array>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Makes App Switcher cards smaller or larger.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Switcher Card Opacity</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabSwitcherCardOpacity</string>
			<key>default</key>
			<real>1.0</real>
			<key>min</key>
			<real>0.2</real>
			<key>max</key>
			<real>1.0</real>
			<key>showValue</key>
			<true/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Adjusts transparency of App Switcher cards.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>label</key>
			<string>Switcher Corner Radius</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabSwitcherCornerRadius</string>
			<key>default</key>
			<real>0.0</real>
			<key>validTitles</key>
			<array>
				<string>Stock</string>
				<string>Rounded</string>
				<string>Rounder</string>
			</array>
			<key>validValues</key>
			<array>
				<real>0.0</real>
				<real>20.0</real>
				<real>32.0</real>
			</array>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Changes the corner radius of App Switcher cards.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Hide Switcher App Icons</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabHideSwitcherAppIcons</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Hides app icons displayed above Switcher cards.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Hide Switcher App Labels</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabHideSwitcherAppLabels</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Hides app names displayed above Switcher cards.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Hide Switcher Background</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabHideSwitcherBackground</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Hides compatible App Switcher background layers.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Switcher Vertical Offset</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabSwitcherVerticalOffset</string>
			<key>default</key>
			<real>0.0</real>
			<key>min</key>
			<real>-80.0</real>
			<key>max</key>
			<real>80.0</real>
			<key>showValue</key>
			<true/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Moves App Switcher cards upward or downward.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Switcher Horizontal Spacing</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabSwitcherHorizontalSpacing</string>
			<key>default</key>
			<real>0.0</real>
			<key>min</key>
			<real>-40.0</real>
			<key>max</key>
			<real>40.0</real>
			<key>showValue</key>
			<true/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Changes the visible spacing between Switcher cards.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Hide Home Screen Card</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabHideSwitcherHomeCard</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Hides a compatible Home Screen card in the Switcher.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Hide Dismiss Hints</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabHideSwitcherDismissHints</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Hides compatible App Switcher dismiss hints.</string>
		</dict>
	</array>
</dict>
</plist>
