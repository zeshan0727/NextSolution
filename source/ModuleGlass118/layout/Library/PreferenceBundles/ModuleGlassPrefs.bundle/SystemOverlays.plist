<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>Screenshots &amp; HUDs</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Screenshots &amp; HUDs</string>
			<key>footerText</key>
			<string>Controls for screenshot feedback, previews, and system HUDs.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Disable Screenshot Flash</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabDisableScreenshotFlash</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Hides the white flash shown when taking a screenshot.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Hide Screenshot Preview</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabHideScreenshotPreview</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Hides the floating screenshot preview thumbnail.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Screenshot Preview Opacity</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabScreenshotPreviewOpacity</string>
			<key>default</key>
			<real>1.0</real>
			<key>min</key>
			<real>0.1</real>
			<key>max</key>
			<real>1.0</real>
			<key>showValue</key>
			<true/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Adjusts transparency of the screenshot preview.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Hide Volume HUD</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabHideVolumeHUD</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Hides the on-screen volume indicator.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Hide Ringer HUD</string>
			<key>defaults</key>
			<string>com.nextsolution.unlockvibrate</string>
			<key>key</key>
			<string>LabHideRingerHUD</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>com.nextsolution.unlockvibrate/preferences.changed</string>
			<key>description</key>
			<string>Hides the on-screen silent and ringer indicator.</string>
		</dict>
	</array>
</dict>
</plist>
