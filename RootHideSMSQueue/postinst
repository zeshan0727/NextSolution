#!/bin/sh

LABEL="com.nextsolution.nextledgersmsd"
JB_BINARY="/usr/libexec/nextledgersmsd"
JB_PLIST="/Library/LaunchDaemons/${LABEL}.plist"
ROOTFS_STATE="/rootfs/var/mobile/Library/NextLedgerSMSImport"
ROOTFS_BINARY="${ROOTFS_STATE}/nextledgersmsd"
INSTALL_LOG="${ROOTFS_STATE}/install.log"

mkdir -p "$ROOTFS_STATE" "$ROOTFS_STATE/pending" "$ROOTFS_STATE/processed" 2>/dev/null || true
: > "$INSTALL_LOG" 2>/dev/null || true
exec >>"$INSTALL_LOG" 2>&1

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Next Ledger SMS Daemon 2.0.1 installation started"
echo "bootstrap binary: $JB_BINARY"
echo "bootstrap plist: $JB_PLIST"

if [ ! -x "$JB_BINARY" ]; then
    echo "ERROR: packaged daemon was not found at $JB_BINARY"
else
    cp -f "$JB_BINARY" "$ROOTFS_BINARY"
    chown root:wheel "$ROOTFS_BINARY" 2>/dev/null || true
    chmod 755 "$ROOTFS_BINARY" 2>/dev/null || true
    echo "Stable daemon copied to /var/mobile/Library/NextLedgerSMSImport/nextledgersmsd"
fi

chown mobile:mobile "$ROOTFS_STATE" "$ROOTFS_STATE/pending" "$ROOTFS_STATE/processed" 2>/dev/null || true
chmod 755 "$ROOTFS_STATE" "$ROOTFS_STATE/pending" "$ROOTFS_STATE/processed" 2>/dev/null || true
chown root:wheel "$ROOTFS_BINARY" 2>/dev/null || true

if command -v jbctl >/dev/null 2>&1 && [ -x "$ROOTFS_BINARY" ]; then
    TRUST_RESULT="$(jbctl trustcache add "$ROOTFS_BINARY" 2>&1)"
    TRUST_CODE=$?
    echo "jbctl trustcache add exit: $TRUST_CODE"
    [ -n "$TRUST_RESULT" ] && echo "$TRUST_RESULT"
else
    echo "WARNING: jbctl was not found; relying on the embedded platform signature"
fi

PLIST_ROOTFS=""
if command -v jbroot >/dev/null 2>&1; then
    PLIST_ROOTFS="$(jbroot "$JB_PLIST" 2>/dev/null || true)"
fi
if [ -z "$PLIST_ROOTFS" ] || [ ! -f "$PLIST_ROOTFS" ]; then
    PLIST_ROOTFS="$JB_PLIST"
fi

echo "Resolved launch plist: $PLIST_ROOTFS"
launchctl bootout "system/$LABEL" >/dev/null 2>&1 || true
launchctl remove "$LABEL" >/dev/null 2>&1 || true

BOOTSTRAP_RESULT="$(launchctl bootstrap system "$PLIST_ROOTFS" 2>&1)"
BOOTSTRAP_CODE=$?
echo "launchctl bootstrap exit: $BOOTSTRAP_CODE"
[ -n "$BOOTSTRAP_RESULT" ] && echo "$BOOTSTRAP_RESULT"

if [ "$BOOTSTRAP_CODE" -ne 0 ]; then
    LOAD_RESULT="$(launchctl load "$PLIST_ROOTFS" 2>&1)"
    LOAD_CODE=$?
    echo "launchctl load fallback exit: $LOAD_CODE"
    [ -n "$LOAD_RESULT" ] && echo "$LOAD_RESULT"
fi

KICK_RESULT="$(launchctl kickstart -k "system/$LABEL" 2>&1)"
KICK_CODE=$?
echo "launchctl kickstart exit: $KICK_CODE"
[ -n "$KICK_RESULT" ] && echo "$KICK_RESULT"

sleep 2
PRINT_RESULT="$(launchctl print "system/$LABEL" 2>&1)"
PRINT_CODE=$?
echo "launchctl print exit: $PRINT_CODE"
[ -n "$PRINT_RESULT" ] && echo "$PRINT_RESULT"

APP_SUPPORT=""
for META in /rootfs/var/mobile/Containers/Data/Application/*/.com.apple.mobile_container_manager.metadata.plist; do
    [ -f "$META" ] || continue
    if grep -a -q "com.nextsolution.dailyledger" "$META" 2>/dev/null; then
        CONTAINER="${META%/.com.apple.mobile_container_manager.metadata.plist}"
        APP_SUPPORT="$CONTAINER/Library/Application Support/DailyLedger"
        break
    fi
done

if [ -n "$APP_SUPPORT" ]; then
    mkdir -p "$APP_SUPPORT" 2>/dev/null || true
    cp -f "$INSTALL_LOG" "$APP_SUPPORT/sms-import-install.log" 2>/dev/null || true
    chown mobile:mobile "$APP_SUPPORT/sms-import-install.log" 2>/dev/null || true
    chmod 644 "$APP_SUPPORT/sms-import-install.log" 2>/dev/null || true
    echo "Installer diagnostic copied into the Next Ledger container"
else
    echo "WARNING: Next Ledger container was not found; open the app once and reinstall the daemon"
fi

echo "[$(date '+%Y-%m-%d %H:%M:%S')] installation finished"
exit 0
