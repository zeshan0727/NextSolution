<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nextsolution.nextledgersmsd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/mobile/Library/NextLedgerSMSImport/nextledgersmsd</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/var/mobile/Library/NextLedgerSMSImport</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>3</integer>
    <key>UserName</key>
    <string>root</string>
    <key>StandardOutPath</key>
    <string>/var/mobile/Library/NextLedgerSMSImport/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Library/NextLedgerSMSImport/launchd.err.log</string>
</dict>
</plist>
