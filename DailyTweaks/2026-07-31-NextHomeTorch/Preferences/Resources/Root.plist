<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>items</key>
  <array>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>Home Screen Flashlight</string>
      <key>footerText</key><string>Double-tap an empty Home Screen area to toggle the flashlight.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Enable Home Screen Flashlight</string>
      <key>key</key><string>enabled</string>
      <key>default</key><true/>
      <key>get</key><string>readPreferenceValue:</string>
      <key>set</key><string>setPreferenceValue:specifier:</string>
    </dict>
  </array>
</dict>
</plist>
