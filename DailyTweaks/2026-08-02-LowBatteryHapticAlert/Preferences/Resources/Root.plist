<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>items</key>
  <array>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>Low Battery Haptic Alert</string>
      <key>footerText</key><string>Plays one warning haptic when the unplugged battery crosses your selected percentage.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Enable Alert</string>
      <key>key</key><string>enabled</string>
      <key>default</key><true/>
      <key>get</key><string>readPreferenceValue:</string>
      <key>set</key><string>setPreferenceValue:specifier:</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>label</key><string>Battery Threshold</string>
      <key>key</key><string>threshold</string>
      <key>default</key><integer>15</integer>
      <key>min</key><integer>5</integer>
      <key>max</key><integer>50</integer>
      <key>showValue</key><true/>
      <key>get</key><string>readPreferenceValue:</string>
      <key>set</key><string>setPreferenceValue:specifier:</string>
    </dict>
  </array>
</dict>
</plist>
